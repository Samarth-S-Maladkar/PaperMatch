# PostgreSQL connection string (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://papermatch:papermatch_dev_password@localhost:5432/papermatch

# Secret used to sign session JWTs / cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Python embedding microservice
EMBEDDING_SERVICE_URL=http://localhost:8000

# Node environment
NODE_ENV=development
